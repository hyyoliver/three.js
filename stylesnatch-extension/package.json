{
  "name": "stylesnatch-extension",
  "version": "1.0.0",
  "description": "抓取网页视觉风格，生成高保真 PowerPoint 模版的 Chrome 插件",
  "main": "scripts/popup.js",
  "scripts": {
    "install-lib": "npm install pptxgenjs && cp node_modules/pptxgenjs/dist/pptxgen.bundle.js lib/",
    "dev": "web-ext run --source-dir=. --browser-console",
    "build": "web-ext build --source-dir=. --artifacts-dir=dist",
    "lint": "eslint scripts/**/*.js"
  },
  "keywords": [
    "chrome-extension",
    "powerpoint",
    "pptx",
    "design",
    "automation",
    "web-scraping",
    "style-guide"
  ],
  "author": "StyleSnatch Team",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.0.0",
    "web-ext": "^7.0.0"
  },
  "dependencies": {
    "pptxgenjs": "^3.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/stylesnatch.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/stylesnatch/issues"
  },
  "homepage": "https://github.com/yourusername/stylesnatch#readme"
}
